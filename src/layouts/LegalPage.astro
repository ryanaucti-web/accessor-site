---
import Base from './Base.astro';

/** Shell for /privacy and /terms. The prose comes in through the default slot
 *  so each page is just its content. `status` renders the review banner: legal
 *  copy has to be signed off by a person, and until it is, the page says so
 *  rather than implying it is binding. */

interface Props {
  title: string;
  description: string;
  h1: string;
  standfirst: string;
  updated: string;
  effective: string;
  operator: string;
  draft?: boolean;
}

const { title, description, h1, standfirst, updated, effective, operator, draft = false } = Astro.props;
---

<Base title={title} description={description}>
  <section class="band band--dark legalHero">
    <div class="legalHero__inner">
      <p class="eyebrow legalHero__eyebrow">Legal</p>
      <h1 class="legalHero__h1">{h1}</h1>
      <p class="legalHero__lede">{standfirst}</p>

      <dl class="meta">
        <div class="meta__row">
          <dt>Last updated</dt>
          <dd>{updated}</dd>
        </div>
        <div class="meta__row">
          <dt>Effective</dt>
          <dd>{effective}</dd>
        </div>
        <div class="meta__row">
          <dt>Operator</dt>
          <dd>{operator}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="band band--paper">
    <div class="legal">
      {
        draft && (
          <p class="draft" role="note">
            <strong>Draft, pending legal review.</strong> This page describes limena's intended practice and is published
            for transparency. It is not a binding agreement until it has been reviewed and dated by counsel. For anything
            you need to rely on today, email <a href="mailto:legal@limena.app">legal@limena.app</a>.
          </p>
        )
      }

      <slot />
    </div>
  </section>
</Base>

<style>
  .legalHero__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .legalHero__eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }

  .legalHero__h1 {
    font-size: 46px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: var(--paper);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .legalHero__lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--on-dark-sage);
    max-width: 60ch;
    margin-bottom: 32px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding-top: 26px;
    border-top: 1px solid var(--on-dark-border);
  }

  .meta__row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta dt {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--green-light);
  }

  .meta dd {
    margin: 0;
    font-size: 14.5px;
    color: var(--on-dark-mist);
  }

  /* ---------- Prose ---------- */

  .legal {
    max-width: 76ch;
    margin: 0 auto;
  }

  .draft {
    padding: 18px 22px;
    margin-bottom: 44px;
    background: var(--attention-tint);
    border-left: 4px solid var(--attention);
    border-radius: var(--r-control-sm);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-700);
  }

  .legal :global(h2) {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-top: 44px;
    margin-bottom: 14px;
  }

  .legal :global(h2:first-of-type) {
    margin-top: 0;
  }

  .legal :global(h3) {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 26px;
    margin-bottom: 8px;
  }

  .legal :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-700);
  }

  .legal :global(p + p) {
    margin-top: 14px;
  }

  .legal :global(ul) {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .legal :global(li) {
    position: relative;
    padding-left: 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-700);
  }

  .legal :global(li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 11px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  .legal :global(a) {
    color: var(--green-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal :global(strong) {
    color: var(--evergreen);
  }

  @media (max-width: 1000px) {
    .legalHero__h1 {
      font-size: 32px;
    }
  }
</style>
