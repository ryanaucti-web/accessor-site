---
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';

/** The four "by situation" use cases share one shape: dark hero, the situation
 *  stated in two paragraphs, a four-step timeline, then a single product mock.
 *  Only the mock differs, so it comes in through the default slot. */

export interface Step {
  when: string;
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  lede: string;
  situationHeading: string;
  situation: string[];
  stepsHeading: string;
  steps: Step[];
  ctaHeading: string;
}

const { title, description, h1, lede, situationHeading, situation, stepsHeading, steps, ctaHeading } = Astro.props;
---

<Base title={title} description={description} active="usecases">
  <section class="band band--dark sHero">
    <div class="sHero__inner">
      <a href="/use-cases" class="sHero__back">← Use cases</a>
      <h1 class="sHero__h1">{h1}</h1>
      <p class="sHero__lede">{lede}</p>
    </div>
  </section>

  <section class="band band--banded situation">
    <div class="situation__inner">
      <p class="eyebrow situation__eyebrow">The situation</p>
      <h2 class="situation__h2">{situationHeading}</h2>
      {situation.map((p) => <p class="situation__p">{p}</p>)}
    </div>
  </section>

  <section class="band band--paper steps">
    <div class="steps__inner">
      <p class="eyebrow steps__eyebrow">How limena helps</p>
      <h2 class="steps__h2">{stepsHeading}</h2>

      <ol class="steps__list">
        {
          steps.map((s) => (
            <li class="step">
              <p class="step__when">{s.when}</p>
              <div>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="steps__mock">
        <slot />
      </div>
    </div>
  </section>

  <CtaBand
    heading={ctaHeading}
    body="Start a 14-day trial on any plan, or see where you stand with a free scan."
    primaryLabel="Start free trial"
    primaryHref="/pricing"
    secondaryLabel="Run a free scan"
    secondaryHref="/scan"
  />
</Base>

<style>
  .sHero {
    padding-bottom: 64px;
  }

  .sHero__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
  }

  .sHero__back {
    display: inline-block;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-light);
    text-decoration: none;
    margin-bottom: 20px;
  }

  .sHero__back:hover {
    color: var(--paper);
  }

  .sHero__h1 {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.03;
    margin-bottom: 22px;
    color: var(--paper);
    max-width: 20ch;
    text-wrap: balance;
  }

  .sHero__lede {
    font-size: 20px;
    line-height: 1.55;
    color: var(--on-dark-sage);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .situation {
    border-bottom: 1px solid rgba(22, 38, 28, 0.06);
  }

  .situation__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .situation__eyebrow,
  .steps__eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 16px;
  }

  .situation__h2 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 18px;
  }

  .situation__p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-700);
  }

  .situation__p + .situation__p {
    margin-top: 16px;
  }

  .steps__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
  }

  .steps__h2 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 36px;
    max-width: 24ch;
  }

  .steps__list {
    border-bottom: 1px solid rgba(22, 38, 28, 0.14);
  }

  .step {
    display: grid;
    grid-template-columns: 0.4fr 1.6fr;
    gap: 28px;
    align-items: baseline;
    border-top: 1px solid rgba(22, 38, 28, 0.14);
    padding: 26px 0;
  }

  .step__when {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--green-hover);
  }

  .step__title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 6px;
  }

  .step__body {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-500);
  }

  .steps__mock {
    margin-top: 48px;
  }

  @media (max-width: 1000px) {
    .sHero__h1 {
      font-size: 36px;
    }
    .sHero__lede {
      font-size: 17.5px;
    }
    .situation__h2,
    .steps__h2 {
      font-size: 26px;
    }
    .step {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 22px 0;
    }
  }
</style>
