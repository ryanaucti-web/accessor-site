---
import Base from '../../layouts/Base.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import FrictionBand from '../../components/product/FrictionBand.astro';
import ProductRow from '../../components/product/ProductRow.astro';
import OutcomeBand from '../../components/product/OutcomeBand.astro';
import CtaBand from '../../components/CtaBand.astro';

const stats = [
  { num: '7', label: 'client workspaces', delta: 'one login', ok: true },
  { num: '4', label: 'on accessibility retainer', delta: 'recurring', ok: true },
  { num: '2', label: 'won from a free test', delta: 'this quarter', ok: true },
  { num: '0', label: 'clients see limena', delta: 'fully white-label', ok: true },
];

const clients = [
  {
    name: 'Riverbend Clinic',
    meta: 'Patient portal · quarterly',
    avatar: { initials: 'RC', role: 'dev' as const },
    bar: 62,
    verdict: 'fail' as const,
    verdictLabel: '3 blocking',
    count: 'retainer',
  },
  {
    name: 'Halvard Municipal',
    meta: 'Service site · monthly',
    avatar: { initials: 'HM', role: 'design' as const },
    bar: 38,
    verdict: 'attention' as const,
    count: 'retainer',
  },
  {
    name: 'Cedar & Co Retail',
    meta: 'Storefront · weekly',
    avatar: { initials: 'CC', role: 'content' as const },
    bar: 24,
    verdict: 'attention' as const,
    count: 'retainer',
  },
  {
    name: 'Fernwood Trust',
    meta: 'Brochure site · quarterly',
    avatar: { initials: 'FT', role: 'dev' as const },
    bar: 6,
    verdict: 'pass' as const,
    verdictLabel: 'Clear',
    count: 'retainer',
  },
  {
    name: 'Marlow Legal',
    meta: 'Free test · not yet engaged',
    avatar: { initials: 'ML', role: 'content' as const },
    bar: 74,
    verdict: 'fail' as const,
    verdictLabel: '9 blocking',
    count: 'prospect',
  },
];

const frictions = [
  {
    title: 'Clients ask, you answer for free',
    d: 'M12 8v4l3 2M12 3a9 9 0 100 18 9 9 0 000-18z',
    body: 'The question arrives mid-project. You investigate, reassure, and write it off, because there is no line item for it in the contract.',
  },
  {
    title: 'You inherit the liability',
    d: 'M12 3l8 4v6c0 4-3.5 7-8 8-4.5-1-8-4-8-8V7l8-4z',
    body: 'You built the site. When a complaint or a failed procurement lands, the client comes to you, whether accessibility was in scope or not.',
  },
  {
    title: 'One-off audits do not retain',
    d: 'M4 12a8 8 0 018-8 8 8 0 016.9 4M20 12a8 8 0 01-8 8 8 8 0 01-6.9-4M18 3v5h-5M6 21v-5h5',
    body: 'You deliver a PDF, the client fixes some of it, and a year later the same conversation starts again from zero. No recurring revenue in it.',
  },
];

const reportRows = [
  { title: 'Appointment form cannot be completed by keyboard', rule: '2.1.1', verdict: 'fail', label: 'Fail' },
  { title: 'Primary button below contrast minimum', rule: '1.4.3', verdict: 'fail', label: 'Fail' },
  { title: 'Heading levels skip on 9 pages', rule: '1.3.1', verdict: 'attention', label: 'Attention' },
];

const steps = [
  {
    n: '1',
    title: 'Test their site before the meeting',
    body: 'Free, no account, about a minute. You arrive with findings from their own product rather than a capability deck.',
  },
  {
    n: '2',
    title: 'Lead with the three that matter',
    body: 'limena has already ranked by who is blocked and from what, so you are talking about their checkout, not a list of 400 errors.',
  },
  {
    n: '3',
    title: 'Scope the retainer, not an audit',
    body: 'Quarterly re-checks, ownership routing, and a live conformance record. That is a recurring engagement, not a one-off deliverable.',
  },
  {
    n: '4',
    title: 'Deliver under your own brand',
    body: 'Spin up their workspace, white-labelled. From their side it is your accessibility practice from day one.',
  },
];

const economics = [
  { label: 'Client workspace', note: 'Wholesale, billed to you annually', val: 'your cost' },
  { label: 'Quarterly accessibility retainer', note: 'What the engagement bills at', val: 'your rate', ok: true },
  { label: 'Remediation and advisory hours', note: 'Where your expertise is billed', val: 'billable', ok: true },
  { label: 'Detection, dedup, and reporting', note: 'Hours you no longer spend', val: 'automated', ok: true },
];

const outcomes = [
  'A recurring retainer instead of a one-off audit nobody renews.',
  'Every client in one workspace, under your brand, switchable from a single login.',
  'A free test that opens the conversation with their findings rather than your credentials.',
  'The detection automated, so your billable hours go to the work only you can do.',
];
---

<Base
  title="limena for service providers"
  description="Clients started asking about accessibility and you have been answering it out of goodwill. This turns it into a service line with margin in it."
  active="partners"
>
  <ProductHero
    backHref="/partners"
    backLabel="Partners"
    title="For service providers"
    lede="Clients started asking about accessibility and you have been answering it out of goodwill. This turns it into a service line with margin in it."
    panelTitle="Northside Studio"
    panelMeta="7 clients · your branding"
    panelStatus="White-label"
    panelStatusTone="pass"
    stats={stats}
    rows={clients}
  />

  <FrictionBand
    heading="Right now accessibility is a cost you absorb."
    lede="A client asks whether the site is accessible. You spend a day looking into it, write something reassuring, and bill none of it."
    items={frictions}
  />

  <ProductRow
    first
    flip
    eyebrow="01 · Your name on it"
    heading="The client sees your practice, not our product."
    body={[
      'Your logo, colours, and domain across the dashboard and every exported report. Findings are already written in plain language, so you hand them over rather than translating first.',
      'If you would rather tell the client which platform you run on, that is your call to make.',
    ]}
  >
    <div class="report">
      <div class="report__head">
        <span class="report__logo" aria-hidden="true">NS</span>
        <span class="report__name">Northside Accessibility Report</span>
        <span class="report__for">Prepared for Riverbend Clinic</span>
      </div>

      <div class="report__body">
        <div class="report__summary">
          <span class="report__verdict">Needs attention</span>
          <span class="report__meta">14 findings · 3 blocking · Q3 review</span>
        </div>

        <ul class="report__rows">
          {
            reportRows.map((r) => (
              <li class="rrow">
                <span class={`rrow__badge rrow__badge--${r.verdict}`}>{r.label}</span>
                <span class="rrow__title">{r.title}</span>
                <span class="rrow__rule">{r.rule}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="report__foot">
        <span>Northside Studio · accessibility practice</span>
        <span class="report__footNote">no limena branding</span>
      </div>
    </div>
  </ProductRow>

  <ProductRow
    eyebrow="02 · How the retainer starts"
    heading="A free test is a better pitch than a proposal."
    body={[
      "Run a client's site before the conversation and walk in with their own findings. It reframes the meeting from whether they need this to which of these to fix first.",
      'Most partners win the first retainer off a test that took them four minutes to run.',
    ]}
  >
    <ol class="steps">
      {
        steps.map((s) => (
          <li class="pstep">
            <span class="pstep__n">{s.n}</span>
            <span class="pstep__body">
              <span class="pstep__title">{s.title}</span>
              <span class="pstep__text">{s.body}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </ProductRow>

  <ProductRow
    last
    flip
    eyebrow="03 · Where the margin sits"
    heading="You bill the judgment, not the sweep."
    body={[
      'limena does the detection, deduplication, and reporting. Your billable hours go to the remediation and the advice, which is the part a client cannot buy from a tool.',
      'Wholesale per client workspace, so the more clients you run, the better the unit economics get.',
    ]}
  >
    <div class="econ">
      <p class="econ__label">A single client engagement</p>
      <ul>
        {
          economics.map((e) => (
            <li class="econ__row">
              <span class="econ__main">
                <span class="econ__name">{e.label}</span>
                <span class="econ__note">{e.note}</span>
              </span>
              <span class={`econ__val ${e.ok ? 'econ__val--ok' : ''}`}>{e.val}</span>
            </li>
          ))
        }
      </ul>
      <p class="econ__foot">
        Illustrative. Your rates and scope decide the actual number, but the shape holds: the platform is a fraction of
        what the work bills at.
      </p>
    </div>
  </ProductRow>

  <OutcomeBand heading="Accessibility as a service line, not a favour." outcomes={outcomes} />

  <CtaBand
    heading="Run it on one client first."
    body="Most partners deliver one engagement through limena before signing anything larger. We would rather you did that too."
    primaryLabel="Talk to partnerships"
    primaryHref="/contact"
    secondaryLabel="Test a client site free"
    secondaryHref="/scan"
  />
</Base>

<style>
  /* ---------- White-labelled report ---------- */

  .report {
    background: var(--white);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-card);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .report__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 22px;
    background: var(--evergreen);
    flex-wrap: wrap;
  }

  /* Stands in for the partner's own mark: the point is that it is not ours. */
  .report__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--green-light);
    color: var(--evergreen);
    font-size: 12px;
    font-weight: 700;
    flex: none;
  }

  .report__name {
    flex: 1;
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--paper);
  }

  .report__for {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-sage);
  }

  .report__body {
    padding: 20px 22px;
  }

  .report__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .report__verdict {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 11px;
    background: var(--attention-tint);
    color: var(--attention-text);
    border-radius: var(--r-pill);
    font-size: 12.5px;
    font-weight: 600;
  }

  .report__meta {
    font-size: 13px;
    color: var(--muted);
  }

  .report__rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rrow {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border);
    border-radius: 11px;
    padding: 12px 14px;
  }

  .rrow__badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 9px;
    border-radius: 7px;
    font-size: 11.5px;
    font-weight: 600;
    flex: none;
  }

  .rrow__badge--fail {
    background: var(--fail-tint);
    color: var(--fail-text);
  }
  .rrow__badge--attention {
    background: var(--attention-tint);
    color: var(--attention-text);
  }

  .rrow__title {
    flex: 1;
    font-size: 14px;
    color: var(--ink-700);
  }

  .rrow__rule {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    flex: none;
  }

  .report__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 22px;
    border-top: 1px solid rgba(22, 38, 28, 0.08);
    background: var(--sunken);
    font-size: 12.5px;
    color: var(--ink-500);
    flex-wrap: wrap;
  }

  .report__footNote {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  /* ---------- Pitch steps ---------- */

  .steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pstep {
    display: flex;
    gap: 16px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card-sm);
    box-shadow: var(--shadow);
    padding: 20px 22px;
  }

  .pstep__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--green-tint);
    color: var(--green-hover);
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 600;
    flex: none;
  }

  .pstep__body {
    flex: 1;
  }

  .pstep__title {
    display: block;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 4px;
  }

  .pstep__text {
    display: block;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-500);
  }

  /* ---------- Economics ---------- */

  .econ {
    background: var(--evergreen);
    border-radius: var(--r-card);
    padding: 28px;
    box-shadow: 0 2px 8px rgba(22, 38, 28, 0.16), 0 30px 60px -34px rgba(22, 38, 28, 0.5);
  }

  .econ__label {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--green-light);
    margin-bottom: 20px;
  }

  .econ__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(244, 241, 234, 0.12);
  }

  .econ__main {
    flex: 1;
    min-width: 0;
  }

  .econ__name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--paper);
  }

  .econ__note {
    display: block;
    font-size: 12.5px;
    color: var(--on-dark-sage);
    margin-top: 2px;
  }

  .econ__val {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--on-dark-mist);
    flex: none;
  }

  .econ__val--ok {
    color: var(--green-light);
  }

  .econ__foot {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--on-dark-sage);
  }
</style>
