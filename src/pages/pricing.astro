---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import CheckCircle from '../components/ui/CheckCircle.astro';

// Prices are hypotheses, not commitments. Change them here and nowhere else.
const plans = [
  {
    name: 'Team',
    forWho: 'For organizations operationalizing accessibility across a focused digital experience.',
    prefix: 'from',
    price: '$500',
    unit: '/ month',
    billing: 'Billed annually at $6k · one digital property',
    cta: 'Book a demo',
    href: '/contact',
    includesLabel: 'The full operating loop, focused scope',
    features: [
      'One primary digital property',
      'Up to 3 active customer journeys',
      'Weekly recurring monitoring',
      'One Jira project, with ticket creation and status sync',
      'Audit intake and manual findings',
      'Unlimited seats',
    ],
  },
  {
    name: 'Growth',
    forWho: 'For organizations managing accessibility across multiple products and customer journeys.',
    prefix: 'from',
    price: '$1,250',
    unit: '/ month',
    billing: 'Billed annually at $15k · multiple properties and teams',
    cta: 'Book a demo',
    href: '/contact',
    badgeLabel: 'Most common',
    includesLabel: 'Everything in Team, at organizational scale',
    features: [
      '3 to 5 digital properties',
      '10 to 20 active journeys',
      'Daily or weekly monitoring',
      'Multiple Jira projects and richer workflow mapping',
      'Multiple product teams and audit sources',
      'Authenticated monitoring where supported',
      'Expanded reporting and API access',
    ],
  },
  {
    name: 'Enterprise',
    forWho: 'For complex, regulated, or large-scale digital environments.',
    prefix: '',
    price: 'Custom',
    unit: '',
    billing: 'Annual agreement · starting around $45k a year',
    cta: 'Talk to sales',
    href: '/contact',
    includesLabel: 'Everything in Growth, across the enterprise',
    features: [
      'Many properties, journeys, and business units',
      'Custom schedules, high volume, deployment-triggered monitoring',
      'Multiple Jira or work-management environments',
      'SAML SSO and enterprise access control',
      'Private runner for protected environments',
      'Security review, custom retention, custom integrations',
      'Named implementation support',
    ],
  },
];

const loop = [
  'Continuous monitoring',
  'Accessibility findings',
  'Audit intake',
  'Journey context and prioritization',
  'Ownership and remediation',
  'Verification',
  'Evidence and history',
  'Workflow connectivity',
];

const drivers = [
  {
    title: 'Properties and journeys',
    body: 'Each website, web app, or product you bring under the loop, and each customer journey limena watches inside it. A checkout, an account opening, an enrolment. More of the organization under monitoring, higher the band.',
  },
  {
    title: 'Monitoring frequency and volume',
    body: 'Weekly on Team, daily or weekly on Growth, custom schedules and deployment-triggered runs on Enterprise. Frequency and scan volume scale the price. The monitoring itself is in every plan.',
  },
  {
    title: 'Teams, integrations, and security',
    body: 'Business units, multiple Jira environments, enterprise identity, authenticated and private environments, security review, retention requirements. Complexity of the deployment, not capability of the product.',
  },
];

const agencyAdds = [
  {
    title: 'Full white-label',
    body: 'Your logo, colours, and domain across the dashboard and every exported report.',
  },
  {
    title: 'Isolated client workspaces',
    body: "Each client's data, programmes, and evidence stay separate. Switch between them from one login.",
  },
  {
    title: 'Client-facing access',
    body: 'Give a client read-only sight of their own programme, or keep it entirely behind your team.',
  },
  {
    title: 'Room to resell',
    body: 'Per-client cost is set so you can package accessibility as a retainer and hold your margin.',
  },
  {
    title: 'The full loop per client',
    body: 'Monitoring, findings, ownership routing, tracker sync, verification, and evidence, scoped to one property per client workspace.',
  },
];

const risks = [
  {
    tag: 'Legal',
    title: 'A demand letter',
    body: 'Accessibility claims are filed in volume and settled quietly. The cost is rarely the settlement alone, it is the emergency remediation that follows on someone else’s timeline.',
  },
  {
    tag: 'Commercial',
    title: 'A failed procurement',
    body: 'Public bodies and large enterprises ask for conformance evidence as a gate. Arriving without it does not lose you points, it removes you from the process.',
  },
  {
    tag: 'Operational',
    title: 'Fixing it late',
    body: 'A barrier caught in design is a conversation. The same barrier caught after launch is a release, a regression risk, and a retrofit across every page that inherited it.',
  },
];

type MatrixRow = [string, string, string, string];

const matrixCore: MatrixRow[] = [
  ['Accessibility baseline', 'yes', 'yes', 'yes'],
  ['Recurring monitoring and regression detection', 'yes', 'yes', 'yes'],
  ['Findings management and audit intake', 'yes', 'yes', 'yes'],
  ['Journey context and prioritization', 'yes', 'yes', 'yes'],
  ['Ownership and remediation workflow', 'yes', 'yes', 'yes'],
  ['Verification of fixes', 'yes', 'yes', 'yes'],
  ['Evidence and history', 'yes', 'yes', 'yes'],
  ['Jira connectivity', 'yes', 'yes', 'yes'],
  ['Unlimited seats', 'yes', 'yes', 'yes'],
];

const matrixScale: MatrixRow[] = [
  ['Digital properties', '1', '3 to 5', 'Custom'],
  ['Active customer journeys', 'Up to 3', '10 to 20', 'Custom'],
  ['Monitoring cadence', 'Weekly', 'Daily or weekly', 'Custom and deploy-triggered'],
  ['Jira projects', '1', 'Multiple', 'Multiple environments'],
  ['Business units', '1', 'Multiple', 'Many'],
  ['Authenticated monitoring', 'Public experiences', 'Where supported', 'Full, with private runner'],
  ['API and integrations', 'Standard', 'Expanded', 'Custom'],
  ['SAML SSO and enterprise access control', 'no', 'no', 'yes'],
  ['Security review, residency, custom retention', 'no', 'no', 'yes'],
];

const faq = [
  {
    q: 'What counts as a digital property?',
    a: 'One website, web app, or product under the loop. Pages and templates inside a property are never counted, so nobody is ever tempted to narrow scope to save money.',
  },
  {
    q: 'What is an active journey?',
    a: 'A path through your product that limena monitors end to end, like a checkout, an account opening, or a course enrolment. Journeys are how findings get business context, so plans are sized by how many you keep active rather than by page count.',
  },
  {
    q: 'limena discovered 1,746 URLs on our site. Are we paying for 1,746 pages?',
    a: 'No. Most of those URLs share a handful of templates, so limena evaluates representative pages and reports the rest as potential affected surface. You pay for the properties and journeys under monitoring, not for the URL count a crawl happens to find.',
  },
  {
    q: 'Why does every plan include Jira?',
    a: 'Because product and engineering should not have to live in limena. Findings that cannot reach the tracker where work actually happens do not get fixed, so basic workflow connectivity is part of the core product, not an upgrade.',
  },
  {
    q: 'What actually changes when we move from Team to Growth?',
    a: 'Scope, not capability. Team already runs the complete loop. Growth runs it across more properties, more journeys, more teams, and a faster monitoring cadence. The reason to upgrade is that you are operating accessibility across more of the organization.',
  },
  {
    q: 'Can limena monitor experiences behind a login?',
    a: 'Growth supports authenticated monitoring where it can be done securely. Enterprise environments that limena cloud should never reach directly can run the private runner inside their own infrastructure, with credentials staying in their own secret manager. Scoped during security review.',
  },
  {
    q: 'Can we start with a pilot?',
    a: 'Yes. A paid pilot runs 60 to 90 days on one property: baseline, recurring monitoring, one existing audit, and one to three critical journeys with the full remediation and verification workflow. If you convert to an annual agreement, the pilot fee is credited toward it.',
  },
  {
    q: 'Why is pricing annual rather than monthly?',
    a: 'Prices are shown per month so plans are easy to compare, but terms are annual. Accessibility is a programme, not a one-off check, and annual terms match the cadence of audits, procurement cycles, and the reporting your stakeholders actually ask for.',
  },
  {
    q: 'Why are seats unlimited?',
    a: 'Because per-seat pricing quietly makes accessibility one person’s job. Findings need to reach designers, content editors, and engineers directly, so the whole team is included on every plan.',
  },
  {
    q: 'Do you offer nonprofit or public sector terms?',
    a: 'Yes. Registered nonprofits, educational institutions, and public bodies have dedicated terms. Tell us your context and we will sort it.',
  },
  {
    q: 'We are an agency. Which plan applies?',
    a: 'The Agency plan. It is priced per client workspace rather than per organization, at wholesale rates set against your client count, so margin stays in your retainer. Each workspace runs the full loop on one property, white-labelled and isolated from your other clients. Talk to partnerships and we will size it with you.',
  },
];
---

<Base
  title="Pricing · limena"
  description="Every limena plan runs the complete operating loop: monitoring, findings, context, remediation, verification, evidence. Price follows the scale it operates at, not which parts you are allowed to use."
  active="pricing"
>
  <!-- HERO -->
  <section class="band band--dark priceHero">
    <div class="priceHero__inner">
      <p class="eyebrow priceHero__eyebrow">Pricing</p>
      <h1 class="priceHero__h1">Pay for scale, not access.</h1>
      <p class="priceHero__lede">
        Every plan runs the complete limena operating loop, from baseline through monitoring, findings, remediation, and
        verification. Price follows how much of your organization the loop operates across, never which parts of it you
        are allowed to use.
      </p>
    </div>
  </section>

  <!-- PLANS -->
  <section class="band band--paper">
    <div class="band__inner">
      <div class="plans">
        {
          plans.map((p, i) => (
            <div class={`plan ${i === 1 ? 'plan--featured' : ''}`}>
              {p.badgeLabel && <span class="plan__badge">{p.badgeLabel}</span>}
              <h2 class="plan__name">{p.name}</h2>
              <p class="plan__for">{p.forWho}</p>

              <p class="plan__priceRow">
                {p.prefix && <span class="plan__prefix">{p.prefix}</span>}
                <span class="plan__price">{p.price}</span>
                {p.unit && <span class="plan__unit">{p.unit}</span>}
              </p>
              <p class="plan__billing">{p.billing}</p>

              <a href={p.href} class={`btn plan__cta ${i === 1 ? 'btn--onGreen' : 'btn--primary'}`}>
                {p.cta}
              </a>

              <p class="plan__includes">{p.includesLabel}</p>
              <ul class="plan__features">
                {p.features.map((f) => (
                  <li class="plan__feature">
                    <CheckCircle size={16} color={i === 1 ? 'var(--green-light)' : 'var(--green-hover)'} />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="loopStrip">
        <p class="loopStrip__label">In every plan</p>
        <ul class="loopStrip__list">
          {
            loop.map((item) => (
              <li class="loopStrip__item">
                <CheckCircle size={16} color="var(--green-hover)" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="loopStrip__note">
          A Team customer runs the same product an Enterprise customer runs. The plans differ in how many properties,
          journeys, teams, and environments the loop covers, and how often it runs. Nonprofits and public bodies have
          dedicated terms.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT DRIVES PRICE -->
  <section class="band band--banded ruled">
    <div class="band__inner">
      <div class="lead">
        <p class="eyebrow">How pricing works</p>
        <h2 class="h2 lead__h2">The loop is never the lever.</h2>
        <p class="lede">
          We do not remove capabilities to make you upgrade, and we do not meter raw URL counts. Three things move the
          price, and all of them are about scale.
        </p>
      </div>

      <div class="drivers">
        {
          drivers.map((d, i) => (
            <div class="card driver">
              <p class="driver__n">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="driver__title">{d.title}</h3>
              <p class="driver__body">{d.body}</p>
            </div>
          ))
        }
      </div>

      <div class="urlNote">
        <div class="urlNote__copy">
          <h3 class="urlNote__title">URLs are not the meter.</h3>
          <p class="urlNote__body">
            A crawl of one route can surface thousands of URLs that share a single template. limena evaluates
            representative pages, reports the rest as potential affected surface, and never bills you for the size of
            the crawl. One template fix can clear the whole route.
          </p>
        </div>
        <div class="urlNote__panel" role="img" aria-label="Example: route /pro/* has 1,746 URLs discovered, 5 representative pages evaluated, a potential shared-template barrier detected, and a potential affected surface of up to 1,746 URLs.">
          <p class="urlNote__route">/pro/*</p>
          <dl class="urlNote__rows">
            <div class="urlNote__row"><dt>URLs discovered</dt><dd>1,746</dd></div>
            <div class="urlNote__row"><dt>Representative pages evaluated</dt><dd>5</dd></div>
            <div class="urlNote__row"><dt>Shared-template barrier</dt><dd>Detected</dd></div>
            <div class="urlNote__row"><dt>Potential affected surface</dt><dd>Up to 1,746 URLs</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENCY MODEL -->
  <section class="band band--paper">
    <div class="band__inner agency">
      <div>
        <p class="eyebrow agency__eyebrow">For agencies and partners</p>
        <h2 class="h2 lead__h2">One workspace, every client.</h2>
        <p class="body agency__body">
          Agencies do not run one accessibility programme, they run a dozen. The Agency plan prices per client workspace
          instead of per organization, so the economics work when you are the one delivering the service.
        </p>
        <p class="body agency__body">
          It is white-label throughout. Your brand on the dashboard, your brand on every report. Clients never see limena
          unless you want them to.
        </p>

        <div class="partnerCard">
          <p class="partnerCard__label">Partner pricing</p>
          <p class="partnerCard__price">Priced per client workspace, scaled to your book.</p>
          <p class="partnerCard__body">
            Wholesale rates that leave margin inside your retainer, with volume terms as your client count grows. Built
            for agencies running accessibility for three or more clients.
          </p>
          <a href="/partners" class="btn btn--primary">See the partner programme</a>
        </div>

        <p class="agency__note">
          Every workspace runs the full loop, scoped to one property per client. A client with several properties, or
          one needing enterprise controls, moves onto a direct plan you can resell.
        </p>
      </div>

      <div class="addsCard">
        <p class="addsCard__label">What the agency plan adds</p>
        <ul>
          {
            agencyAdds.map((a) => (
              <li class="add">
                <CheckCircle size={17} />
                <span class="add__main">
                  <span class="add__title">{a.title}</span>
                  <span class="add__body">{a.body}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="addsCard__note">
          Reselling under your own SKU, or running accessibility for more than 25 clients? That is a partnership
          conversation rather than a plan.
        </p>
      </div>
    </div>
  </section>

  <!-- RISK ANCHOR -->
  <section class="band band--dark">
    <div class="band__inner">
      <div class="lead">
        <p class="eyebrow">What this is measured against</p>
        <h2 class="h2 riskLead__h2">The cost of not knowing.</h2>
        <p class="lede">
          Accessibility is one of the few product risks that arrives as a legal letter rather than a bug report. These
          are the events limena exists to prevent.
        </p>
      </div>

      <div class="risks">
        {
          risks.map((r) => (
            <div class="riskCard">
              <p class="riskCard__tag">{r.tag}</p>
              <h3 class="riskCard__title">{r.title}</h3>
              <p class="riskCard__body">{r.body}</p>
            </div>
          ))
        }
      </div>

      <p class="riskNote">
        Set against any one of these, the question stops being what limena costs and becomes what it is worth to know
        first.
      </p>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="band band--paper">
    <div class="band__inner">
      <h2 class="h2 matrix__h2">How the plans scale</h2>

      <div class="tableWrap">
        <table class="matrix">
          <caption class="visually-hidden">
            What every plan includes, and how scope scales across the Team, Growth, and Enterprise plans.
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Team</th>
              <th scope="col">Growth</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr class="matrix__group">
              <th scope="rowgroup" colspan="4">The operating loop, in every plan</th>
            </tr>
            {
              matrixCore.map(([label, a, b, c]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {[a, b, c].map(() => (
                    <td class="cell--yes">
                      <span aria-hidden="true">✓</span>
                      <span class="visually-hidden">Included</span>
                    </td>
                  ))}
                </tr>
              ))
            }
            <tr class="matrix__group">
              <th scope="rowgroup" colspan="4">Scale and environment</th>
            </tr>
            {
              matrixScale.map(([label, a, b, c]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {[a, b, c].map((v) => (
                    <td class={v === 'yes' ? 'cell--yes' : v === 'no' ? 'cell--no' : 'cell--text'}>
                      {v === 'yes' ? (
                        <>
                          <span aria-hidden="true">✓</span>
                          <span class="visually-hidden">Included</span>
                        </>
                      ) : v === 'no' ? (
                        <>
                          <span aria-hidden="true">·</span>
                          <span class="visually-hidden">Not included</span>
                        </>
                      ) : (
                        v
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="matrixNote">
        Enterprise agreements are scoped to the deployment, and large ones scale with it. The private runner executes
        evaluations inside your own infrastructure, retrieving credentials from your own secret manager, so protected
        environments never open a door to limena cloud. Scoped with your security team during review.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band--banded ruled">
    <div class="band__inner">
      <h2 class="h2 faq__h2">Common questions</h2>
      <div class="faq">
        {
          faq.map((q) => (
            <div class="faqItem">
              <h3 class="faqItem__q">{q.q}</h3>
              <p class="faqItem__a">{q.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Land with one experience."
    body="We will baseline one property, monitor one to three journeys that matter, and prove the loop works before you commit to more. Pilots run 60 to 90 days and credit toward an annual agreement."
    primaryLabel="Book a demo"
    primaryHref="/contact"
    secondaryLabel="Test a page free"
    secondaryHref="/scan"
  />
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .ruled {
    border-top: 1px solid rgba(22, 38, 28, 0.06);
    border-bottom: 1px solid rgba(22, 38, 28, 0.06);
  }

  .lead {
    max-width: 62ch;
    margin-bottom: 44px;
  }

  .lead .eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 16px;
  }

  .lead__h2 {
    margin-bottom: 14px;
  }

  /* ---------- Hero ---------- */

  .priceHero__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    text-align: center;
  }

  .priceHero__eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }

  .priceHero__h1 {
    font-size: 54px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--paper);
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .priceHero__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--on-dark-sage);
    max-width: 62ch;
    margin: 0 auto;
    text-wrap: pretty;
  }

  /* ---------- Plans ---------- */

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
  }

  .plan {
    position: relative;
    background: var(--white);
    border: 1px solid var(--border-strong);
    border-radius: 20px;
    padding: 34px;
    box-shadow: 0 1px 2px rgba(22, 38, 28, 0.04), 0 22px 44px -34px rgba(22, 38, 28, 0.3);
  }

  .plan--featured {
    background: var(--evergreen);
    border-color: var(--evergreen);
    color: var(--paper);
    box-shadow: 0 2px 6px rgba(22, 38, 28, 0.1), 0 34px 64px -32px rgba(22, 38, 28, 0.6);
  }

  .plan__badge {
    position: absolute;
    top: -12px;
    left: 34px;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 12px;
    background: var(--green-light);
    color: var(--evergreen);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }

  .plan__name {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 7px;
  }

  .plan__for {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-500);
    margin-bottom: 24px;
    min-height: 66px;
  }

  .plan--featured .plan__for {
    color: var(--on-dark-sage);
  }

  .plan__priceRow {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
  }

  .plan__prefix,
  .plan__unit {
    font-size: 15px;
    color: var(--muted);
  }

  .plan--featured .plan__prefix,
  .plan--featured .plan__unit {
    color: var(--on-dark-sage);
  }

  .plan__prefix {
    font-weight: 500;
  }

  .plan__price {
    font-size: 46px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .plan__billing {
    font-size: 13px;
    color: var(--muted);
    margin-top: 10px;
    margin-bottom: 22px;
  }

  .plan--featured .plan__billing {
    color: var(--on-dark-sage);
  }

  .plan__cta {
    width: 100%;
    margin-bottom: 26px;
  }

  .plan__includes {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .plan--featured .plan__includes {
    color: var(--green-light);
  }

  .plan__features {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .plan__feature {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-700);
  }

  .plan--featured .plan__feature {
    color: var(--on-dark-mist);
  }

  .plan__feature :global(svg) {
    margin-top: 2px;
  }

  /* ---------- Loop strip ---------- */

  .loopStrip {
    margin-top: 32px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 28px 30px;
  }

  .loopStrip__label {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-hover);
    margin-bottom: 16px;
  }

  .loopStrip__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px 20px;
  }

  .loopStrip__item {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-700);
