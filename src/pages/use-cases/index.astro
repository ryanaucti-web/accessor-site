---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';

const before = [
  'Accessibility lives in a PDF nobody reads',
  'Ownership is unclear, so fixes stall',
  'Specialists become the bottleneck for everything',
  'Every release quietly reintroduces barriers',
  'Progress is impossible to measure or prove',
];

const after = [
  'Every barrier is visible in one shared system',
  'Each fix has a named owner and a tracker ticket',
  'AI handles volume; specialists handle judgment',
  'Every release is verified against regressions',
  'Maturity and evidence are measurable over time',
];

const relay = [
  { n: '01', who: 'Leadership', what: 'Sees maturity and trend across every product, and sets the target.' },
  { n: '02', who: 'Product and UX', what: 'Get barriers ranked by impact, so accessibility fits the roadmap.' },
  {
    n: '03',
    who: 'Engineering and content',
    what: 'Receive the fix and the element in their tracker, in plain language.',
  },
  { n: '04', who: 'Accessibility and QA', what: 'Verify the fix and sign off the calls that need human judgment.' },
  { n: '05', who: 'Compliance', what: 'Draw a live VPAT and evidence straight from the work, no scramble.' },
];

const situations = [
  {
    title: 'Preparing for an audit',
    body: 'An audit or VPAT is due and you need defensible evidence, fast, not a last-minute scramble.',
    href: '/use-cases/preparing-for-an-audit',
  },
  {
    title: 'Many products, one standard',
    body: 'Portfolios and agencies keeping dozens of digital products to the same bar, from one workspace.',
    href: '/use-cases/many-products-one-standard',
  },
  {
    title: 'Continuous delivery',
    body: 'Teams shipping every week that need accessibility verified at each release, in the pipeline.',
    href: '/use-cases/continuous-delivery',
  },
  {
    title: 'Distributed product teams',
    body: 'Many autonomous squads that need shared visibility without a central bottleneck.',
    href: '/use-cases/distributed-teams',
  },
];

const industries = [
  {
    title: 'Government',
    href: '/use-cases/government',
    d: 'M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6',
    body: 'Vast content estates, legislated standards, and public accountability. Hundreds of services change constantly, and procurement wants evidence, not promises.',
  },
  {
    title: 'Healthcare',
    href: '/use-cases/healthcare',
    d: 'M12 5v14M5 12h14',
    body: 'Patient portals, clinical apps, forms, and digital labeling, all high-stakes, all regulated, all needing evidence that accessibility held as they changed.',
  },
  {
    title: 'Financial services',
    href: '/use-cases/financial-services',
    d: 'M4 19V5M4 19h16M8 16v-4M12 16V8M16 16v-6',
    body: 'Transactional systems and statements shipping on a fast release cadence, where a single inaccessible flow blocks people from their own money.',
  },
  {
    title: 'Higher education',
    href: '/use-cases/higher-education',
    d: 'M12 4L2 9l10 5 10-5-10-5zM6 11v5c0 1 3 2.5 6 2.5s6-1.5 6-2.5v-5',
    body: 'Learning platforms and student portals owned by autonomous departments, each publishing independently, all under one institutional obligation.',
  },
  {
    title: 'Manufacturing',
    href: '/use-cases/manufacturing',
    d: 'M3 21V8l6-3v4l6-3v4l6-3v14M3 21h18M8 21v-4h3v4',
    body: 'Dealer and customer portals, internal tools, documentation, and training systems, sprawling digital estates on complex, staggered release cycles.',
  },
  {
    title: 'Retail',
    href: '/use-cases/retail',
    d: 'M3 7h18l-1.5 13H4.5L3 7zM8 7V5a4 4 0 018 0v2',
    body: 'The most-sued sector online, and the one that can price a barrier precisely, because a checkout someone cannot finish is a lost order you can count.',
  },
  {
    title: 'Accounting firms',
    href: '/use-cases/accounting-firms',
    d: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h4',
    body: 'Thousands of statements, returns, and reports sent to clients every year, almost none of them tagged, and each one its own artifact.',
  },
];
---

<Base
  title="Use cases · limena"
  description="However your organization ships, one product or a hundred, weekly releases or an audit next quarter, the operating loop adapts to it."
  active="usecases"
>
  <!-- HERO -->
  <section class="band band--dark hubHero">
    <div class="hubHero__inner">
      <p class="eyebrow hubHero__eyebrow">Use cases</p>
      <h1 class="hubHero__h1">Accessibility Operations fits how you already work.</h1>
      <p class="hubHero__lede">
        However your organization ships, one product or a hundred, weekly releases or an audit next quarter, the
        operating loop adapts to it. Here's how it runs inside teams like yours.
      </p>
    </div>
  </section>

  <!-- THE SHIFT -->
  <section class="band band--paper shift">
    <div class="shift__inner">
      <div class="lead lead--center">
        <p class="eyebrow">The shift</p>
        <h2 class="h2">What changes when accessibility becomes an operation.</h2>
      </div>

      <div class="shift__grid">
        <div class="shiftCard shiftCard--before">
          <p class="shiftCard__label shiftCard__label--before">Before limena</p>
          <ul>
            {
              before.map((b) => (
                <li class="shiftCard__item">
                  <span class="shiftCard__mark shiftCard__mark--x" aria-hidden="true">
                    ✕
                  </span>
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="shift__arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="var(--paper)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>

        <div class="shiftCard shiftCard--after">
          <p class="shiftCard__label shiftCard__label--after">After limena</p>
          <ul>
            {
              after.map((a) => (
                <li class="shiftCard__item shiftCard__item--after">
                  <span class="shiftCard__mark shiftCard__mark--check" aria-hidden="true">
                    ✓
                  </span>
                  <span>{a}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM RELAY -->
  <section class="band band--banded ruled">
    <div class="hub__inner">
      <div class="lead lead--center lead--wide">
        <p class="eyebrow">Across your organization</p>
        <h2 class="h2 lead__h2">A barrier moves through your team, not around it.</h2>
        <p class="lede">
          Accessibility Operations is a relay. limena hands each barrier to the right function with the context they
          need, and passes it on when their part is done.
        </p>
      </div>

      <ol class="relay">
        {
          relay.map((r) => (
            <li class="relay__row">
              <span class="relay__n">{r.n}</span>
              <span class="relay__who">{r.who}</span>
              <span class="relay__what">{r.what}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- BY SITUATION -->
  <section class="band band--paper">
    <div class="band__inner">
      <div class="lead lead--center">
        <p class="eyebrow">By how you operate</p>
        <h2 class="h2">Find the situation you're in.</h2>
      </div>

      <div class="grid2">
        {
          situations.map((s) => (
            <a href={s.href} class="linkCard">
              <h3 class="linkCard__title">{s.title}</h3>
              <p class="linkCard__body">{s.body}</p>
              <span class="linkCard__cta">Read the use case →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BY INDUSTRY -->
  <section class="band band--banded ruled">
    <div class="hub__inner">
      <div class="lead lead--center lead--wide">
        <p class="eyebrow">By industry</p>
        <h2 class="h2 lead__h2">Where accessibility is operationally hard.</h2>
        <p class="lede">Not a list of logos, the reason each of these industries needs an operation, not an audit.</p>
      </div>

      <div class="grid3">
        {
          industries.map((i) => (
            <a href={i.href} class="linkCard">
              <span class="linkCard__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={i.d} stroke="var(--green-hover)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <h3 class="linkCard__title linkCard__title--sm">{i.title}</h3>
              <p class="linkCard__body">{i.body}</p>
            </a>
          ))
        }

        <div class="askCard">
          <h3 class="linkCard__title linkCard__title--sm">Your industry?</h3>
          <p class="linkCard__body">If you run digital experiences under a compliance obligation, the loop fits.</p>
          <a href="/contact" class="askCard__link">Talk to us →</a>
        </div>
      </div>

      <p class="hub__note">
        limena operates on digital experiences, websites, web apps, and documents, not physical products or
        environments.
      </p>
    </div>
  </section>

  <CtaBand
    heading="See it run in your world."
    body="Start a 14-day trial on any plan, or see where you stand with a free scan."
    primaryLabel="Start free trial"
    primaryHref="/pricing"
    secondaryLabel="Run a free scan"
    secondaryHref="/scan"
  />
</Base>

<style>
  .hubHero {
    padding-bottom: 72px;
  }

  .hubHero__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    text-align: center;
  }

  .hubHero__eyebrow {
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }

  .hubHero__h1 {
    font-size: 60px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-bottom: 22px;
    color: var(--paper);
    text-wrap: balance;
  }

  .hubHero__lede {
    font-size: 20px;
    line-height: 1.55;
    color: var(--on-dark-sage);
    margin: 0 auto;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .hub__inner,
  .shift__inner {
    max-width: 1160px;
    margin: 0 auto;
  }

  .ruled {
    border-top: 1px solid rgba(22, 38, 28, 0.06);
    border-bottom: 1px solid rgba(22, 38, 28, 0.06);
  }

  .lead {
    max-width: 60ch;
    margin: 0 auto 44px;
  }

  .lead--wide {
    max-width: 64ch;
  }

  .lead--center {
    text-align: center;
  }

  .lead .eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 16px;
  }

  .lead__h2 {
    margin-bottom: 14px;
  }

  /* ---------- Before and after ---------- */

  .shift__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 28px;
    align-items: stretch;
  }

  .shiftCard {
    border-radius: var(--r-card);
    padding: 30px;
  }

  .shiftCard--before {
    border: 1px solid rgba(22, 38, 28, 0.14);
    background: rgba(178, 74, 51, 0.04);
  }

  .shiftCard--after {
    border: 1px solid rgba(44, 122, 82, 0.3);
    background: var(--green-tint);
  }

  .shiftCard__label {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .shiftCard__label--before {
    color: var(--fail-text);
  }
  .shiftCard__label--after {
    color: var(--green-hover);
  }

  .shiftCard__item {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-700);
  }

  .shiftCard__item + .shiftCard__item {
    margin-top: 14px;
  }

  .shiftCard__item--after {
    color: var(--evergreen);
  }

  .shiftCard__mark {
    flex: none;
    margin-top: 1px;
  }

  .shiftCard__mark--x {
    color: var(--fail);
  }
  .shiftCard__mark--check {
    color: var(--green);
  }

  .shift__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shift__arrow svg {
    width: 44px;
    height: 44px;
    padding: 11px;
    border-radius: 50%;
    background: var(--green);
    flex: none;
  }

  /* ---------- Relay ---------- */

  .relay {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .relay__row {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card-sm);
    padding: 20px 24px;
  }

  .relay__n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    flex: none;
    width: 24px;
  }

  .relay__who {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
    flex: none;
    width: 210px;
  }

  .relay__what {
    font-size: 14.5px;
    color: var(--ink-500);
    line-height: 1.45;
  }

  /* ---------- Cards ---------- */

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .linkCard {
    display: block;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 30px;
    text-decoration: none;
    color: inherit;
    transition: border-color 140ms ease, transform 140ms ease;
  }

  .linkCard:hover {
    border-color: rgba(44, 122, 82, 0.5);
    transform: translateY(-2px);
  }

  .linkCard__icon {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--green-tint);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .linkCard__title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .linkCard__title--sm {
    font-size: 20px;
  }

  .linkCard__body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-500);
  }

  .linkCard__cta {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--green-hover);
  }

  .askCard {
    background: var(--sunken);
    border: 1px dashed rgba(22, 38, 28, 0.2);
    border-radius: var(--r-card);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .askCard__link {
    margin-top: 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--green-hover);
    text-decoration: none;
    align-self: flex-start;
  }

  .askCard__link:hover {
    color: var(--evergreen);
  }

  .hub__note {
    font-size: 13.5px;
    color: var(--muted);
    text-align: center;
    margin: 22px auto 0;
    max-width: 60ch;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1000px) {
    .hubHero__h1 {
      font-size: 38px;
    }
    .hubHero__lede {
      font-size: 17.5px;
    }
    .shift__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .shift__arrow svg {
      transform: rotate(90deg);
    }
    .grid2,
    .grid3 {
      grid-template-columns: 1fr;
    }
    .relay__row {
      flex-wrap: wrap;
      gap: 6px 16px;
    }
    .relay__who {
      width: auto;
    }
    .relay__what {
      flex-basis: 100%;
    }
  }
</style>
