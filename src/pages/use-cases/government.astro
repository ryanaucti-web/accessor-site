---
import Base from '../../layouts/Base.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import FrictionBand from '../../components/product/FrictionBand.astro';
import ProductRow from '../../components/product/ProductRow.astro';
import RankedPanel from '../../components/product/RankedPanel.astro';
import FindingCard from '../../components/product/FindingCard.astro';
import EvidencePanel from '../../components/product/EvidencePanel.astro';
import OutcomeBand from '../../components/product/OutcomeBand.astro';
import CtaBand from '../../components/CtaBand.astro';
import CheckCircle from '../../components/ui/CheckCircle.astro';

const stats = [
  { num: '2', label: 'statutory services blocked', delta: 'no offline route' },
  { num: '184k', label: 'claims a year affected', delta: 'benefit service' },
  { num: '4', label: 'vendor-built services', delta: '2 renewals due' },
  { num: '6', label: 'need a specialist verdict', delta: 'queued', ok: true },
];

const services = [
  {
    name: 'Benefit claim',
    meta: 'Errors in colour only · paper form retired',
    src: 'STATUTORY',
    srcTone: 'strong' as const,
    bar: 74,
    verdict: 'fail' as const,
    count: '12',
  },
  {
    name: 'Licence renewal',
    meta: 'Date picker unusable with a screen reader',
    src: 'STATUTORY',
    srcTone: 'strong' as const,
    bar: 62,
    verdict: 'fail' as const,
    count: '9',
  },
  {
    name: 'Permit applications',
    meta: 'Vendor platform · renewal in October',
    src: 'VENDOR',
    bar: 44,
    verdict: 'attention' as const,
    count: '21',
  },
  {
    name: 'Public consultations',
    meta: 'Untagged PDFs · 1,900 documents',
    src: 'DOCS',
    bar: 38,
    verdict: 'attention' as const,
    count: '34',
  },
  {
    name: 'Main information site',
    meta: 'Central digital team · weekly releases',
    src: 'IN HOUSE',
    bar: 8,
    verdict: 'pass' as const,
    count: '0',
  },
  {
    name: 'Open data portal',
    meta: 'Vendor platform · VPAT on file',
    src: 'VENDOR',
    bar: 4,
    verdict: 'pass' as const,
    count: '0',
  },
];

const frictions = [
  {
    title: 'Digital-first removed the fallback',
    d: 'M6 3h9l4 4v14H6zM14 3v5h5',
    body: 'Paper forms and counters were retired to save money. That was defensible only if the digital route worked for everyone, and for some services it does not.',
  },
  {
    title: 'The estate is procured, not built',
    d: 'M5 11h14v10H5zM8.5 11V8a3.5 3.5 0 017 0v3',
    body: 'Most services run on vendor platforms you cannot patch. Evidence has to be strong enough to move a supplier or a renewal negotiation.',
  },
  {
    title: 'A complaint becomes a public matter',
    d: 'M12 3l8 4v6c0 4-3.5 7-8 8-4.5-1-8-4-8-8V7l8-4z',
    body: 'In the private sector this is a support ticket. Here it can become an access-to-information request, an ombudsman file, or a news story.',
  },
];

const ranked = [
  {
    rank: '01',
    title: 'Benefit claim errors in colour only',
    chip: 'Statutory',
    tone: 'high' as const,
    why: 'No announced reason for rejection, and no paper alternative. The claim simply cannot be completed.',
  },
  {
    rank: '02',
    title: 'Licence renewal date picker unusable',
    chip: 'Statutory',
    tone: 'high' as const,
    why: 'Only self-serve route to renew. Fallback is a 22 minute assisted call.',
  },
  {
    rank: '03',
    title: 'Contrast on policy library pages',
    chip: 'Informational',
    tone: 'neutral' as const,
    why: 'Content available in other formats and reflows correctly at 200 percent zoom.',
  },
];

const standards = [
  { label: 'Accessible Canada Act', count: 'Plan, feedback, progress reports', val: 'Statutory' },
  { label: 'CAN/ASC-EN 301 549:2024', count: 'National Standard of Canada', val: 'WCAG 2.1 AA' },
  { label: 'AODA, Ontario', count: 'Provincial obligation', val: 'WCAG 2.0 AA' },
  { label: 'Resolved target', count: 'Highest bar across all three', val: 'WCAG 2.2 AA', ok: true },
];

// The obligation is a cycle, not a pass mark. This is the argument no other
// use-case page makes, and the one a federal visitor came to the stand with.
const cycle = [
  {
    title: 'The plan has to name barriers',
    body: 'A plan listing intentions and no barriers is the one that draws a complaint. limena gives you the inventory the plan is meant to describe, ranked by who is shut out.',
  },
  {
    title: 'The progress report has to show movement',
    body: 'Next year you have to say what changed. Verified fixes carrying a date and evidence are the difference between a progress report and a restatement.',
  },
  {
    title: 'Feedback arrives as a barrier, not a ticket',
    body: 'Someone tells you they could not renew a licence. limena ties that to the finding, the service, and the fix, so your response cites a record rather than an assurance.',
  },
];

const outcomes = [
  'Statutory services separated from informational pages, so the work starts where residents are actually shut out.',
  'Barriers stated as consequences, in language a service owner and an ombudsman both understand.',
  'Vendor findings packaged for renewal negotiations, where you have leverage you do not have in code.',
  'One programme satisfying every standard you answer to, run against the highest bar rather than three times.',
];
---

<Base
  title="Accessibility for government · limena"
  description="Nobody can opt out of your services. When a form is inaccessible, the fallback is a phone queue, an office visit, or going without a benefit someone is entitled to."
  active="usecases"
>
  <ProductHero
    backHref="/use-cases"
    backLabel="Use cases"
    title="Accessibility for government"
    lede="Nobody can opt out of your services. When a form is inaccessible, the fallback is a phone queue, an office visit, or going without a benefit someone is entitled to."
    panelTitle="Service estate"
    panelMeta="6 services · 41,000 pages"
    panelStatus="2 statutory services blocked"
    stats={stats}
    rows={services}
  />

  <FrictionBand
    heading="There is no competitor to switch to."
    lede="Commercial sites lose a customer. You leave a resident unable to renew a licence, file a return, or claim a benefit, and the obligation to serve them does not go away."
    items={frictions}
  />

  <ProductRow
    first
    eyebrow="01 · Ranked by who is shut out"
    heading="A blocked benefit claim outranks everything else."
    body={[
      'limena scores by what a person cannot complete and whether another route exists. Statutory services with no offline alternative come first, and a policy page with the same rule violation comes last.',
      'Forms are almost always the surface that matters, and almost always the least tested.',
    ]}
  >
    <RankedPanel head="Fix these first" meta="by service impact" items={ranked} />
  </ProductRow>

  <ProductRow
    flip
    eyebrow="02 · Consequence, not category"
    heading="What happens to the person who cannot get through."
    body={[
      "limena states the fallback: a phone queue, an office visit, or nothing. That is the language a service owner and a minister's office both understand, and it is also what appears in a complaint.",
      'Findings needing human judgment are flagged for your specialist rather than passed as automated.',
    ]}
  >
    <FindingCard
      verdict="Fail"
      title="Benefit claim errors are announced only in colour"
      error="When a claim is rejected, the failing fields turn red with no announced message and no programmatic association. A screen reader user submits, hears nothing change, and has no way to know which answer was wrong."
      impact="Statutory service, <strong>184,000 claims a year</strong>, no offline alternative since the paper form was retired. Blocked residents fall back to a <strong>22 minute assisted call</strong> or abandon the claim."
      impactLabel="Service impact"
      impactIcon="shield"
      owner={{
        initials: 'SD',
        role: 'dev',
        name: 'Service delivery, digital team',
        meta: 'Also queued for a specialist verdict before sign-off',
        action: 'Queue for review',
      }}
    />
  </ProductRow>

  <ProductRow
    last
    eyebrow="03 · Legislated, and audited"
    heading="One record, every standard you answer to."
    body={[
      'Most of your estate is vendor-built and procured, so the lever is the contract. limena holds each supplier to the same bar and produces the evidence pack that goes into a renewal or an accessibility complaint response.',
      'EN 301 549 is a National Standard of Canada now, published as CAN/ASC-EN 301 549:2024, so the requirement you write into a solicitation and the bar you hold the delivered product to are finally the same document.',
      'Multiple jurisdictions resolve to the highest bar, so one programme satisfies all of them rather than running three.',
    ]}
  >
    <EvidencePanel
      head="Standards in scope"
      action="Export"
      rows={standards}
      note="All three resolve to WCAG 2.2 AA, so the programme is run once against the highest bar."
    />
  </ProductRow>

  <!-- The obligation this page has to state plainly, because it is a cycle
       rather than a pass mark, and the cycle is what limena actually is. -->
  <section class="band band--banded cycle">
    <div class="cycle__inner">
      <div>
        <p class="eyebrow cycle__eyebrow">The obligation, precisely</p>
        <h2 class="cycle__h2">The Act does not ask whether your site is accessible.</h2>
        <p class="cycle__body">
          It asks you to publish a three year accessibility plan, run a process for receiving feedback about barriers,
          and publish a progress report in the years between describing what actually changed.
        </p>
        <p class="cycle__body cycle__body--emph">
          That is an operating loop with an evidence requirement attached. It is a different problem from passing a scan,
          and it is the one that comes back every year.
        </p>
      </div>

      <div class="cycle__list">
        {
          cycle.map((c) => (
            <div class="cycleCard">
              <p class="cycleCard__title">{c.title}</p>
              <p class="cycleCard__body">{c.body}</p>
            </div>
          ))
        }
        <div class="cycleNote">
          <CheckCircle size={17} />
          <span>
            The plan and the progress report are themselves published documents, held to the same bar as the services
            they describe. limena audits PDF, Word, and PowerPoint alongside the sites.
          </span>
        </div>
      </div>
    </div>
  </section>

  <OutcomeBand heading="Services that work for everyone entitled to use them." outcomes={outcomes} />

  <CtaBand
    heading="Start with your busiest form."
    body="The one most residents have to get through, and the one most likely to be blocking someone today."
    primaryLabel="Book a demo"
    primaryHref="/contact"
    secondaryLabel="Canadian data residency"
    secondaryHref="/canadian-residency"
  />
</Base>

<style>
  .cycle {
    border-top: 1px solid rgba(22, 38, 28, 0.06);
    border-bottom: 1px solid rgba(22, 38, 28, 0.06);
  }

  .cycle__inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.44fr 0.56fr;
    gap: 56px;
    align-items: start;
  }

  .cycle__eyebrow {
    display: block;
    margin-bottom: 16px;
  }

  .cycle__h2 {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 18px;
    text-wrap: balance;
  }

  .cycle__body {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--ink-500);
  }

  .cycle__body + .cycle__body {
    margin-top: 14px;
  }

  .cycle__body--emph {
    color: var(--ink-700);
  }

  .cycle__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cycleCard {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 20px 22px;
  }

  .cycleCard__title {
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 6px;
  }

  .cycleCard__body {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-500);
  }

  .cycleNote {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 18px 22px;
    background: var(--green-tint);
    border-radius: var(--r-control);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-700);
  }

  @media (max-width: 1000px) {
    .cycle__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cycle__h2 {
      font-size: 27px;
    }
  }
</style>
