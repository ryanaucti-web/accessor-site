---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

const principles = [
  {
    n: '01',
    title: 'Plain language wins',
    body: "If a finding needs a specialist to decode, it won't get fixed. We write for everyone who touches the site.",
  },
  {
    n: '02',
    title: 'Calm over loud',
    body: 'No scare tactics, no red-alert dashboards. Even failures are stated plainly, so teams can act without panic.',
  },
  {
    n: '03',
    title: 'In service of the work',
    body: 'White-label by default. limena sits behind your brand and the people doing the real work of inclusion.',
  },
];
---

<Base
  title="About limena"
  description="limen is Latin for threshold, and specifically the threshold of perception. Accessibility is the line between a web someone can use and one they cannot."
  active="about"
>
  <!-- THE NAME -->
  <section class="name">
    <div>
      <p class="eyebrow name__eyebrow">The name</p>
      <h1 class="name__h1">limen <span class="name__phon">/ˈlaɪmən/</span></h1>
      <p class="name__lede">
        Latin for <strong>threshold</strong>, and specifically the <em>threshold of perception</em>: the exact point where
        something crosses from unnoticed into noticed.
      </p>
      <p class="name__body">
        That's the whole idea. Accessibility is the line between a web someone can use and one they can't. limena's job
        is to show you where that line sits, and help everything cross it.
      </p>
    </div>

    <div class="name__figure">
      <div class="threshold">
        <!-- The mark, animated: a disc rising until it crests the perception
             line. Decorative, so it is hidden from assistive tech and stops
             entirely under prefers-reduced-motion. -->
        <svg viewBox="0 0 320 240" width="100%" aria-hidden="true">
          <defs>
            <radialGradient id="discGrad" cx="50%" cy="40%" r="62%">
              <stop offset="0%" stop-color="#9FE3BE"></stop>
              <stop offset="100%" stop-color="#4FA97A"></stop>
            </radialGradient>
            <radialGradient id="haloGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#74C79A" stop-opacity="0.5"></stop>
              <stop offset="100%" stop-color="#74C79A" stop-opacity="0"></stop>
            </radialGradient>
            <clipPath id="aboutAbove"><rect x="0" y="0" width="320" height="140"></rect></clipPath>
          </defs>

          <text
            x="160"
            y="30"
            text-anchor="middle"
            font-family="JetBrains Mono"
            font-size="11"
            font-weight="600"
            fill="#74C79A"
            letter-spacing="0.06em">THE THRESHOLD</text
          >

          <circle class="lim-glow" cx="160" cy="132" r="66" fill="url(#haloGrad)"></circle>
          <!-- The faint full disc is the unnoticed state below the line. -->
          <circle cx="160" cy="140" r="46" fill="#74C79A" opacity="0.12"></circle>
          <!-- The bright disc is clipped to above the line: what has crossed. -->
          <g class="lim-rise">
            <circle cx="160" cy="140" r="46" fill="url(#discGrad)" clip-path="url(#aboutAbove)"></circle>
          </g>
          <line class="lim-pulse" x1="44" y1="140" x2="276" y2="140" stroke="#74C79A" stroke-width="2.5" stroke-linecap="round"
          ></line>
          <circle class="lim-ripple" cx="160" cy="140" r="2" fill="none" stroke="#9FE3BE" stroke-width="2"></circle>

          <text x="160" y="224" text-anchor="middle" font-family="Hanken Grotesk" font-size="14" fill="#CFE0D5"
            >unnoticed → noticed</text
          >
        </svg>
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="band band--dark">
    <div class="mission">
      <p class="eyebrow mission__eyebrow">Why we built it</p>
      <p class="mission__lead">
        The web already had plenty of tools that <span class="mission__find">find</span> accessibility problems. Almost none
        made them easy to <span class="mission__understand">understand</span>, so the reports got filed, and the barriers
        stayed.
      </p>
      <p class="mission__body">
        limena is built around one belief: an accessibility finding only matters if someone acts on it. So every barrier
        we surface is written in plain language: what's wrong, who it affects, and how to fix it, for the whole team, not
        just the specialist.
      </p>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="band band--paper principles">
    <div class="band__inner">
      <h2 class="h2 principles__h2">What we hold to</h2>
      <div class="principles__grid">
        {
          principles.map((p) => (
            <div class="pcard">
              <p class="pcard__n">{p.n}</p>
              <h3 class="pcard__title">{p.title}</h3>
              <p class="pcard__body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Help your corner of the web cross the line."
    body="Start with a scan. See where you stand, in plain language."
    primaryLabel="See how it works"
    primaryHref="/platform"
    secondaryLabel="View pricing"
    secondaryHref="/pricing"
  />
</Base>

<style>
  .name {
    max-width: var(--content);
    margin: 0 auto;
    padding: 80px var(--gutter) 64px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: center;
  }

  .name__eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }

  .name__h1 {
    font-size: 68px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 24px;
  }

  .name__phon {
    color: var(--muted);
    font-weight: 500;
    font-size: 34px;
    letter-spacing: -0.01em;
  }

  .name__lede {
    font-size: 20px;
    line-height: 1.6;
    color: var(--ink-500);
    margin-bottom: 18px;
    max-width: 48ch;
    text-wrap: pretty;
  }

  .name__lede strong {
    color: var(--evergreen);
  }

  .name__body {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-500);
    max-width: 48ch;
    text-wrap: pretty;
  }

  .name__figure {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .threshold {
    background: var(--evergreen);
    border-radius: 24px;
    padding: 48px;
    width: 100%;
  }

  .lim-rise {
    animation: limRise 5s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }
  .lim-glow {
    animation: limGlow 5s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }
  .lim-pulse {
    animation: limPulse 5s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }
  .lim-ripple {
    animation: limRipple 5s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  @keyframes limRise {
    0%,
    18% {
      transform: translateY(58px);
    }
    52%,
    80% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(58px);
    }
  }

  @keyframes limGlow {
    0%,
    18% {
      opacity: 0;
    }
    50%,
    78% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes limPulse {
    0%,
    40% {
      opacity: 0.5;
      stroke-width: 2.5;
    }
    50% {
      opacity: 1;
      stroke-width: 3.5;
    }
    62%,
    100% {
      opacity: 0.5;
      stroke-width: 2.5;
    }
  }

  @keyframes limRipple {
    0%,
    44% {
      opacity: 0;
      r: 2;
    }
    52% {
      opacity: 0.55;
      r: 8;
    }
    72% {
      opacity: 0;
      r: 40;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lim-rise,
    .lim-glow,
    .lim-pulse,
    .lim-ripple {
      animation: none !important;
    }
    /* Without the animation the disc would sit below the line, which reads as
       the wrong half of the story. Rest it at the crest instead. */
    .lim-rise {
      transform: translateY(0);
    }
    .lim-glow {
      opacity: 1;
    }
  }

  /* ---------- Mission ---------- */

  .mission {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .mission__eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    margin-bottom: 22px;
  }

  .mission__lead {
    font-size: 32px;
    line-height: 1.34;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--paper);
    text-wrap: balance;
  }

  .mission__find {
    color: var(--on-dark-sage);
  }

  .mission__understand {
    color: var(--green-light);
  }

  .mission__body {
    font-size: 18px;
    line-height: 1.62;
    color: var(--on-dark-mist);
    margin: 32px auto 0;
    max-width: 56ch;
    text-wrap: pretty;
  }

  /* ---------- Principles ---------- */

  .principles__h2 {
    text-align: center;
    margin-bottom: 44px;
  }

  .principles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .pcard {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 32px;
  }

  .pcard__n {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--green-hover);
    margin-bottom: 14px;
  }

  .pcard__title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 9px;
  }

  .pcard__body {
    font-size: 15px;
    line-height: 1.58;
    color: var(--ink-500);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1000px) {
    .name {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 56px 24px 48px;
    }
    .name__h1 {
      font-size: 46px;
    }
    .name__phon {
      font-size: 24px;
    }
    .name__lede {
      font-size: 18px;
    }
    .mission__lead {
      font-size: 24px;
    }
    .principles__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .name__h1 {
      font-size: 36px;
    }
    .threshold {
      padding: 28px;
    }
  }
</style>
