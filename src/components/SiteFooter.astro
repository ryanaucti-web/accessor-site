---
import Logo from './Logo.astro';

const columns = [
  {
    head: 'Platform',
    links: [
      { label: 'How it works', href: '/platform' },
      { label: 'Use cases', href: '/use-cases' },
      { label: 'Partners', href: '/partners' },
      { label: 'Free scan', href: '/scan' },
      { label: 'Pricing', href: '/pricing' },
    ],
  },
  {
    head: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Security', href: '/security' },
      { label: 'Book a demo', href: '/contact' },
    ],
  },
  {
    head: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
    ],
  },
];
---

<footer class="foot">
  <div class="foot__top">
    <div class="foot__brandCol">
      <a href="/" class="foot__brand">
        <Logo size={26} id="footMark" />
        <span>limena</span>
      </a>
      <p class="foot__tagline">
        Accessibility intelligence. Coined from <em>limen</em>, the threshold of perception.
      </p>
    </div>

    <div class="foot__cols">
      {
        columns.map((col) => (
          <nav class="foot__col" aria-label={col.head}>
            <h2 class="foot__head">{col.head}</h2>
            {col.links.map((l) => (
              <a href={l.href} class="foot__link">{l.label}</a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>

  <div class="foot__legal">© 2026 limena · built to WCAG 2.2 AA · made for everyone</div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.4);
  }

  .foot__top {
    max-width: var(--content);
    margin: 0 auto;
    padding: 52px var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .foot__brandCol {
    max-width: 300px;
  }

  .foot__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 14px;
    text-decoration: none;
    color: inherit;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .foot__tagline {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .foot__cols {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }

  .foot__col {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .foot__head {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 3px;
  }

  .foot__link {
    font-size: 15px;
    color: var(--ink-500);
    text-decoration: none;
  }

  .foot__link:hover {
    color: var(--evergreen);
  }

  .foot__legal {
    max-width: var(--content);
    margin: 0 auto;
    padding: 0 var(--gutter) 40px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .foot__top {
      padding: 40px 24px;
    }
    .foot__cols {
      gap: 32px;
    }
    .foot__legal {
      padding: 0 24px 32px;
    }
  }
</style>
