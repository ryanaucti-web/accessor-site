#!/usr/bin/env bash
# Accessor installer.
#
# Usage:
#   bash <(curl -fsSL https://accessor.shortux.com/install)
#
# What this checks and what it can install for you:
#   - Node.js 20+ ........... can install portable into ~/.accessor/ (no admin)
#   - GitHub CLI (gh) ....... can install portable into ~/.accessor/ (no admin)
#   - git ................... must already be present (xcode-select or apt)
#   - Python 3.9+ ........... must already be present (macOS 12+ has it)
#
# Customers with everything pre-installed run straight through. Customers
# missing Node or gh get a yes/no prompt offering portable downloads (no
# admin, no Homebrew). Customers missing git or Python are told to ask IT
# or install via the official source.

set -euo pipefail

# Pinned versions. Bump and re-deploy when refreshing.
NODE_VERSION="22.11.0"
GH_VERSION="2.93.0"

BOLD=$(tput bold 2>/dev/null || true)
DIM=$(tput dim 2>/dev/null || true)
RED=$(tput setaf 1 2>/dev/null || true)
GREEN=$(tput setaf 2 2>/dev/null || true)
YELLOW=$(tput setaf 3 2>/dev/null || true)
PURPLE=$(tput setaf 5 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

step() { printf '\n%s==>%s %s%s%s\n' "${PURPLE}" "${RESET}" "${BOLD}" "$1" "${RESET}"; }
ok()   { printf '%s ✓%s %s\n' "${GREEN}" "${RESET}" "$1"; }
warn() { printf '%s ⚠%s %s\n' "${YELLOW}" "${RESET}" "$1"; }
fail() { printf '%s ✗%s %s\n' "${RED}" "${RESET}" "$1" >&2; exit 1; }
info() { printf '%s   %s%s\n' "${DIM}" "$1" "${RESET}"; }

need_cmd() { command -v "$1" >/dev/null 2>&1; }

version_ge() {
  local v1="$1" v2="$2"
  [ "$(printf '%s\n%s\n' "$v1" "$v2" | sort -V | head -n 1)" = "$v2" ]
}

ACCESSOR_DIR="${ACCESSOR_DIR:-$HOME/accessor}"
ACCESSOR_FULL_BROWSERS="${ACCESSOR_FULL_BROWSERS:-0}"
ACCESSOR_SKIP_LICENSE="${ACCESSOR_SKIP_LICENSE:-0}"
AUDITS_ROOT="$HOME/.accessibility-audits"
SKILL_PATH="$HOME/.claude/skills/accessibility-audit"
DASHBOARD_REPO="shortux/accessibility-dashboard"
SKILL_REPO="shortux/accessibility-audit-skill"
ACCESSOR_HOME="$HOME/.accessor"
ACCESSOR_BIN="$ACCESSOR_HOME/bin"
ACCESSOR_NODE_DIR="$ACCESSOR_HOME/node"

# Platform detection
case "$(uname -s)" in
  Darwin*) PLATFORM="macos" ;;
  Linux*)  PLATFORM="linux" ;;
  *) fail "Unsupported platform: $(uname -s). macOS and Linux only." ;;
esac

ARCH_RAW=$(uname -m)
case "$ARCH_RAW" in
  arm64|aarch64) NODE_ARCH="arm64"; GH_ARCH="arm64" ;;
  x86_64|amd64)  NODE_ARCH="x64";   GH_ARCH="amd64" ;;
  *) fail "Unsupported architecture: $ARCH_RAW" ;;
esac

# If portable installs from previous runs exist, put them on PATH first
export PATH="$ACCESSOR_BIN:$ACCESSOR_NODE_DIR/bin:$PATH"

printf '\n'
printf '%s  Accessor installer%s\n' "${BOLD}" "${RESET}"
printf '%s  Local-first accessibility auditing. Built in Ottawa.%s\n' "${DIM}" "${RESET}"
printf '\n'

# -------- prerequisite check --------
step "Checking prerequisites"

portable_missing=()   # things we can install for the customer (Node, gh)
manual_missing=()     # things they have to install themselves (git, python3)

# Node
if need_cmd node; then
  NODE_HAVE=$(node -p "process.versions.node" 2>/dev/null || echo "0.0.0")
  if version_ge "$NODE_HAVE" "20.0.0"; then
    ok "Node $NODE_HAVE"
  else
    info "Found Node $NODE_HAVE but Accessor needs 20+"
    portable_missing+=("node")
  fi
else
  portable_missing+=("node")
fi

# git
if need_cmd git; then
  ok "git $(git --version | awk '{print $3}')"
else
  manual_missing+=("git")
fi

# gh
if need_cmd gh; then
  ok "gh $(gh --version | head -1 | awk '{print $3}')"
else
  portable_missing+=("gh")
fi

# Python 3.9+
PY=""
for c in python3.12 python3.11 python3.10 python3.9 python3 python; do
  if need_cmd "$c"; then PY="$c"; break; fi
done
if [ -n "$PY" ]; then
  PY_VERSION=$("$PY" -c 'import sys; print("{}.{}.{}".format(*sys.version_info[:3]))' 2>/dev/null || echo "0.0.0")
  if version_ge "$PY_VERSION" "3.9.0"; then
    ok "python3 $PY_VERSION ($PY)"
  else
    info "Found Python $PY_VERSION but Accessor needs 3.9+"
    manual_missing+=("python3")
  fi
else
  manual_missing+=("python3")
fi

# -------- handle missing prerequisites --------

# Anything that can't be auto-installed bails the script.
if [ "${#manual_missing[@]}" -gt 0 ]; then
  printf '\n'
  warn "The following must be installed manually before re-running:"
  info ""
  for tool in "${manual_missing[@]}"; do
    case "$tool" in
      git)
        if [ "$PLATFORM" = "macos" ]; then
          info "  git → run \`xcode-select --install\` (or ask IT to run it). This"
          info "        pops up a GUI installer and does require an admin password."
        else
          info "  git → sudo apt install git (or your distro's equivalent)"
        fi
        ;;
      python3)
        if [ "$PLATFORM" = "macos" ]; then
          info "  python3 → on macOS 12+ this should be at /usr/bin/python3. If"
          info "            it's not, ask IT to install Python 3.9 or newer."
        else
          info "  python3 → sudo apt install python3 (or your distro's equivalent)"
        fi
        ;;
    esac
  done
  info ""
  fail "Install the above, then re-run: bash <(curl -fsSL https://accessor.shortux.com/install)"
fi

# Node and gh CAN be auto-installed. Ask the user.
if [ "${#portable_missing[@]}" -gt 0 ]; then
  printf '\n'
  warn "Missing: ${portable_missing[*]}"
  info ""
  info "I can either:"
  info "  1) Download portable copies into ~/.accessor/ (no admin needed,"
  info "     no system changes, lives entirely in your home folder)"
  info "  2) Exit so you install them yourself from the official sources:"
  info "     - Node: https://nodejs.org (install the LTS)"
  info "     - GitHub CLI: https://cli.github.com"
  info ""
  read -r -p "Choose [1/2] (default 1): " choice
  choice="${choice:-1}"
  if [ "$choice" != "1" ]; then
    info "OK — install the missing tools and re-run the installer."
    exit 0
  fi

  # Install whichever portable things are missing
  mkdir -p "$ACCESSOR_BIN" "$ACCESSOR_NODE_DIR"

  for tool in "${portable_missing[@]}"; do
    case "$tool" in
      node)
        step "Downloading portable Node $NODE_VERSION into $ACCESSOR_NODE_DIR"
        if [ "$PLATFORM" = "macos" ]; then
          TARBALL="node-v${NODE_VERSION}-darwin-${NODE_ARCH}.tar.xz"
        else
          TARBALL="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"
        fi
        URL="https://nodejs.org/dist/v${NODE_VERSION}/${TARBALL}"
        TMP=$(mktemp -d)
        if ! curl -fsSL "$URL" -o "$TMP/$TARBALL"; then
          fail "Couldn't download $URL. Check network/proxy and try again."
        fi
        rm -rf "$ACCESSOR_NODE_DIR"
        mkdir -p "$ACCESSOR_NODE_DIR"
        tar -xJf "$TMP/$TARBALL" -C "$TMP"
        EXTRACTED=$(find "$TMP" -maxdepth 1 -type d -name 'node-v*' | head -1)
        [ -z "$EXTRACTED" ] && fail "Tarball layout unexpected."
        cp -R "$EXTRACTED"/* "$ACCESSOR_NODE_DIR"/
        rm -rf "$TMP"
        [ "$PLATFORM" = "macos" ] && xattr -dr com.apple.quarantine "$ACCESSOR_NODE_DIR" 2>/dev/null || true
        export PATH="$ACCESSOR_NODE_DIR/bin:$PATH"
        need_cmd node || fail "Node not on PATH after install."
        ok "Node $(node -p process.versions.node) at $ACCESSOR_NODE_DIR"
        ;;
      gh)
        step "Downloading portable GitHub CLI $GH_VERSION into $ACCESSOR_BIN"
        if [ "$PLATFORM" = "macos" ]; then
          FILENAME="gh_${GH_VERSION}_macOS_${GH_ARCH}.zip"
        else
          FILENAME="gh_${GH_VERSION}_linux_${GH_ARCH}.tar.gz"
        fi
        URL="https://github.com/cli/cli/releases/download/v${GH_VERSION}/${FILENAME}"
        TMP=$(mktemp -d)
        if ! curl -fsSL "$URL" -o "$TMP/$FILENAME"; then
          fail "Couldn't download $URL. Check network/proxy and try again."
        fi
        cd "$TMP"
        if [ "$PLATFORM" = "macos" ]; then
          unzip -q "$FILENAME"
        else
          tar -xzf "$FILENAME"
        fi
        GH_BIN=$(find "$TMP" -type f -name 'gh' -path '*/bin/gh' | head -1)
        [ -z "$GH_BIN" ] && fail "gh binary not found inside $FILENAME."
        cp "$GH_BIN" "$ACCESSOR_BIN/gh"
        chmod +x "$ACCESSOR_BIN/gh"
        [ "$PLATFORM" = "macos" ] && xattr -dr com.apple.quarantine "$ACCESSOR_BIN/gh" 2>/dev/null || true
        cd - >/dev/null
        rm -rf "$TMP"
        export PATH="$ACCESSOR_BIN:$PATH"
        need_cmd gh || fail "gh not on PATH after install."
        ok "gh $GH_VERSION at $ACCESSOR_BIN/gh"
        ;;
    esac
  done

  # Persist PATH for future shell sessions
  step "Persisting PATH updates"
  rc=""
  case "$(basename "${SHELL:-}")" in
    zsh)  rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *)    rc="$HOME/.profile" ;;
  esac
  if [ -n "$rc" ] && [ -f "$rc" ] && grep -q 'ACCESSOR_HOME' "$rc"; then
    info "Already added to $rc"
  elif [ -n "$rc" ]; then
    cat >> "$rc" <<EOF

# Added by Accessor installer ($(date +%Y-%m-%d))
export ACCESSOR_HOME="\$HOME/.accessor"
[ -d "\$ACCESSOR_HOME/bin" ] && export PATH="\$ACCESSOR_HOME/bin:\$PATH"
[ -d "\$ACCESSOR_HOME/node/bin" ] && export PATH="\$ACCESSOR_HOME/node/bin:\$PATH"
EOF
    info "Added 5 PATH lines to $rc"
  fi
fi

# -------- GitHub authentication --------
step "GitHub CLI authentication"
if gh auth status >/dev/null 2>&1; then
  ok "Already authenticated as $(gh api user --jq .login 2>/dev/null || echo "(unknown)")"
else
  info "Accessor's source repos are private. The GitHub CLI will open a"
  info "browser. Pick GitHub.com, HTTPS, and sign in normally."
  read -r -p "Press Enter to start GitHub auth, or Ctrl-C to abort: " _
  gh auth login --git-protocol https --web
fi
GH_USER=$(gh api user --jq .login 2>/dev/null || true)
[ -z "$GH_USER" ] && fail "Could not read GitHub username after auth. Try \`gh auth login\` manually."
ok "Authenticated as $GH_USER"

# -------- Clone repos --------
step "Cloning the dashboard into $ACCESSOR_DIR"
CLONE_ERR_FILE=$(mktemp -t accessor-clone-err.XXXXXX)
if [ -d "$ACCESSOR_DIR/.git" ]; then
  info "Existing clone detected; pulling latest..."
  git -C "$ACCESSOR_DIR" pull --ff-only
else
  if ! gh repo clone "$DASHBOARD_REPO" "$ACCESSOR_DIR" -- --depth=1 2>"$CLONE_ERR_FILE"; then
    if grep -qi "not found\|denied\|404\|forbidden" "$CLONE_ERR_FILE"; then
      warn "GitHub denied access to $DASHBOARD_REPO."
      info ""
      info "Your GitHub user ($GH_USER) hasn't been added as a collaborator."
      info "Email ryan@shortux.com with this GitHub username and Ryan will"
      info "add you within a few hours. Then re-run this installer."
      info ""
      sed 's/^/  /' "$CLONE_ERR_FILE" >&2
      rm -f "$CLONE_ERR_FILE"
      exit 2
    fi
    warn "Clone failed. Error output:"
    sed 's/^/  /' "$CLONE_ERR_FILE" >&2
    rm -f "$CLONE_ERR_FILE"
    exit 1
  fi
fi
rm -f "$CLONE_ERR_FILE"
ok "Dashboard cloned"

step "Cloning the audit skill into $SKILL_PATH"
mkdir -p "$(dirname "$SKILL_PATH")"
SKILL_ERR_FILE=$(mktemp -t accessor-skill-err.XXXXXX)
if [ -d "$SKILL_PATH/.git" ]; then
  info "Existing clone detected; pulling latest..."
  git -C "$SKILL_PATH" pull --ff-only
else
  if ! gh repo clone "$SKILL_REPO" "$SKILL_PATH" -- --depth=1 2>"$SKILL_ERR_FILE"; then
    warn "Could not clone the skill repo. If this is also a 'not found',"
    warn "Ryan needs to add you to that repo too. Email ryan@shortux.com."
    info ""
    sed 's/^/  /' "$SKILL_ERR_FILE" >&2
    rm -f "$SKILL_ERR_FILE"
    exit 2
  fi
fi
rm -f "$SKILL_ERR_FILE"
ok "Skill cloned"

# -------- npm install + setup --------
step "Installing Node dependencies (this takes a minute)"
cd "$ACCESSOR_DIR"
npm install --no-audit --no-fund
ok "Dashboard dependencies installed"

if npm run | grep -q '^  setup'; then
  step "Running npm run setup"
  npm run setup
  ok "Setup complete"
fi

step "Installing Playwright browser binaries"
cd "$SKILL_PATH"
if [ -f package.json ]; then
  npm install --no-audit --no-fund
  if [ "$ACCESSOR_FULL_BROWSERS" = "1" ]; then
    info "Pulling Chromium + Firefox + WebKit (~400 MB)..."
    npx --yes playwright install chromium firefox webkit
  else
    info "Pulling Chromium (~150 MB)..."
    npx --yes playwright install chromium
  fi
  ok "Playwright ready"
fi

# -------- License placement --------
step "Placing your license file"
mkdir -p "$AUDITS_ROOT"
LICENSE_TARGET="$AUDITS_ROOT/license.json"

if [ "$ACCESSOR_SKIP_LICENSE" = "1" ]; then
  info "Skipping license placement (ACCESSOR_SKIP_LICENSE=1)."
elif [ -f "$LICENSE_TARGET" ]; then
  ok "License already in place at $LICENSE_TARGET"
else
  FOUND=""
  for c in "$HOME/Downloads/license.json" "$HOME/Downloads"/license-*.json \
           "$HOME/Desktop/license.json" "$HOME/Desktop"/license-*.json; do
    [ -f "$c" ] && FOUND="$c" && break
  done
  if [ -n "$FOUND" ]; then
    cp "$FOUND" "$LICENSE_TARGET"
    ok "Copied $FOUND to $LICENSE_TARGET"
  else
    warn "No license.json found in ~/Downloads or ~/Desktop."
    info "Drop it into ~/Downloads, then press Enter to retry."
    info "Or type 'skip' to continue without a license (new audits will be blocked)."
    while true; do
      read -r -p "Path to license.json (or 'skip'): " LIC
      [ "$LIC" = "skip" ] || [ -z "$LIC" ] && { warn "Continuing without a license."; break; }
      LIC="${LIC/#\~/$HOME}"
      if [ -f "$LIC" ]; then
        cp "$LIC" "$LICENSE_TARGET"
        ok "Copied $LIC to $LICENSE_TARGET"
        break
      fi
      warn "File not found: $LIC"
    done
  fi
fi

# -------- Launch --------
step "Starting the dashboard"
cd "$ACCESSOR_DIR"
info "Dashboard runs in the foreground. Press Ctrl-C to stop it."
info "Open http://localhost:7878 in your browser."

( sleep 2 && {
    if [ "$PLATFORM" = "macos" ]; then
      open http://localhost:7878 >/dev/null 2>&1 || true
    elif need_cmd xdg-open; then
      xdg-open http://localhost:7878 >/dev/null 2>&1 || true
    fi
} ) &

exec npm start
